{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "astrum-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "astrum-vite",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "--port", "5175"],
      "port": 5175
    },
    {
      "name": "astrum-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "apps/api",
      "port": 3001
    },
    {
      "name": "astrum-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "preview", "--port", "4173"],
      "port": 4173
    }
  ]
}
