# ASTRUM AI ENGINE â€” VariÃ¡veis de Ambiente
# Copie para .env e preencha com valores reais
# NUNCA commite o arquivo .env
# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

# Servidor
NODE_ENV=development
PORT=3000
FASTIFY_PORT=3001
LOG_LEVEL=info

# Supabase (obrigatÃ³rio)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_JWT_SECRET=seu-jwt-secret-do-dashboard   # Settings -> API -> JWT Secret (FZ-3: verificação de tokens no backend)

# â”€â”€â”€ Redis (obrigatÃ³rio â€” mÃ­nimo 32 chars) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REDIS_PASSWORD=GERAR_COM_OPENSSL_NAO_USAR_ESTE_VALOR
# O formato da URL inclui a senha inline:
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379
# Em dev local sem Docker: redis://:${REDIS_PASSWORD}@localhost:6379

# â”€â”€â”€ Qdrant (obrigatÃ³rio em produÃ§Ã£o) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Gerar com: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
QDRANT_API_KEY=GERAR_COM_OPENSSL_NAO_USAR_ESTE_VALOR
QDRANT_URL=http://qdrant:6333
# Em dev local sem Docker: http://localhost:6333

# â”€â”€â”€ Zep (memÃ³ria de longo prazo) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# DSN com usuÃ¡rio zep_user de least-privilege (ver infra/sql/create-zep-user.sql)
ZEP_POSTGRES_DSN=postgres://zep_user:SENHA_ZEP@db.xxx.supabase.co:5432/postgres?search_path=zep
ZEP_API_URL=http://zep:8000
ZEP_API_KEY=your-zep-api-key

# OpenAI (obrigatÃ³rio)
OPENAI_API_KEY=sk-...

# JWT (obrigatÃ³rio â€” mÃ­nimo 64 chars)
# Gerar com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GERAR_COM_OPENSSL_MINIMO_64_CHARS_NAO_USAR_ESTE_VALOR

# SEC-R1: cifra de campo (CPF + credenciais de ERP). 32 bytes = 64 hex chars.
# SEM prefixo VITE_ (não pode ir para o bundle do frontend). Cifra é FAIL-CLOSED:
# se esta env faltar, encrypt/decrypt LANÇAM (o CPF nunca é gravado em texto puro).
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CPF_ENCRYPTION_KEY=GERAR_32_BYTES_EM_HEX_NAO_USAR_ESTE_VALOR

# CORS
ALLOWED_ORIGINS=http://localhost:5173,https://app.astrum.com.br

# WhatsApp / Evolution API
EVOLUTION_API_URL=https://sua-evolution.com
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=GERAR_COM_OPENSSL_NAO_USAR_ESTE_VALOR

# Webhooks HMAC
FACEBOOK_APP_SECRET=
PAYMENT_WEBHOOK_SECRET=
WEBHOOK_HMAC_SECRET=GERAR_COM_OPENSSL_MINIMO_32_CHARS

# Helicone â€” FinOps IA
HELICONE_API_KEY=

# Sentry â€” Observabilidade
SENTRY_DSN=

# LangSmith â€” Tracing IA
# ATENÃ‡ÃƒO: em produÃ§Ã£o, LANGCHAIN_TRACING=false para nÃ£o vazar dados de clientes
LANGCHAIN_API_KEY=ls__sua_chave_aqui
LANGCHAIN_TRACING=false
LANGCHAIN_PROJECT=astrum-production

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=astrum-documents
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# Svix â€” Outbound Webhooks
SVIX_API_KEY=your-svix-api-key

# Cloudflare Workers
CLOUDFLARE_ACCOUNT_ID=your-account-id
# â”€â”€â”€ Engine Flags (S68 â€” ContenÃ§Ã£o Strangler Fig) â”€â”€â”€
# Controla qual implementaÃ§Ã£o sobe por domÃ­nio durante a migraÃ§Ã£o. Ver CLAUDE.md R6.
# Apenas UMA engine por domÃ­nio pode estar ativa (evita cobranÃ§a/atendimento duplo).
COBRAI_ENGINE=legacy        # legacy | v2  (cutover na S76)
ATENDIMENTO_ENGINE=legacy   # legacy | v2  (cutover na S74)
MULTI_AGENT_ENABLED=false   # true | false  (IA-10; só ativa quando ATENDIMENTO_ENGINE=v2)

# --- IA-NEXTGEN Feature Flags (Parte 2) ---
INTELLIGENCE_HUB_ENABLED=false   # true | false  (IA-11; ativa Central de Inteligência no nav)
TOOL_REGISTRY_ENABLED=false      # true | false  (IA-19; permite ligar/desligar tools do agente por tenant)
SAFETY_CLASSIFIER_ENABLED=false  # true | false  (IA-21; classificador constitucional de respostas)
GRAPHRAG_ENABLED=false           # true | false  (IA-16; tool de grafo de rede + tela de consulta)
LIVE_TRANSLATION_ENABLED=false  # true | false  (IA-14; atendimento multilíngue com RAG traduzido)
PROMPT_COMPRESSION_ENABLED=false  # true | false  (IA-30; compressão determinística de contexto RAG)
TOOL_BATCHING_ENABLED=false      # true | false  (IA-37; tool calls independentes do mesmo step em paralelo)
FEATURE_STORE_ENABLED=false      # true | false  (IA-27; feature store para ML pipelines)
BANDIT_ENABLED=false             # true | false  (IA-26; multi-armed bandit para seleção de prompts)
DRIFT_DETECTION_ENABLED=false    # true | false  (IA-33; detecção de drift em embeddings/prompts)
AGENT_SANDBOX_ENABLED=false      # true | false  (IA-44; sandbox SQL seguro para consultas do agente)
PROVIDER_FAILOVER_ENABLED=false  # true | false  (IA-43; failover automático entre providers LLM)
REPLAY_ENGINE_ENABLED=false      # true | false  (IA-46; replay de conversas para validação)
OTEL_ENABLED=false               # true | false  (IA-32; tracing distribuído OpenTelemetry)
NIGHTLY_BRAIN_ENABLED=false      # true | false  (F2-01; calibração noturna do RAG)
WIND_TUNNEL_ENABLED=false        # true | false  (D-15; túnel de vento com personas sintéticas — APENAS em staging)
NOC_AUTONOMO_ENABLED=false       # true | false  (D-04; NOC autônomo com telemetria SNMP)

# --- Flags de segunda onda (habilitar conforme maturidade) ---
CHURN_ENGINE=false               # true | false  (IA-38; predição de churn com SHAP explanations)
LTV_ENABLED=false                # true | false  (IA-23; estimativa de LTV por assinante)
LATENCY_BUDGET_ENABLED=false     # true | false  (IA-35; budget de latência por tier de tenant)
SYNTH_DATA_ENABLED=false         # true | false  (IA-45; geração de dados sintéticos para treino)
MODEL_ELO_ENABLED=false          # true | false  (IA-31; ranking ELO entre modelos)
ACTIVE_LEARNING_ENABLED=false    # true | false  (IA-29; loop de aprendizado ativo)
CTO_ALERT_ENABLED=false          # true | false  (IA-09; alertas de métricas para CTO)
VOICE_ENGINE=off                 # off | mvp  (IA-08; engine de voz em tempo real)
EDGE_INFERENCE_MODE=off          # off | shadow  (IA-36; inferência edge via Cloudflare Workers AI)
NETWORK_ANOMALY_ENABLED=false    # true | false  (IA-24; detecção de anomalias de rede)
DEMAND_FORECAST_ENABLED=false    # true | false  (IA-25; previsão de demanda/capacidade)
VOICE_QA_ENABLED=false           # true | false  (IA-13; QA automática de conversas de voz)
VOICE_PII_MASK_ENABLED=false     # true | false  (IA-40; mascaramento PII em transcrições)
VOICE_BIOMETRICS_ENABLED=false   # true | false  (IA-12; biometria vocal para autenticação)

# --- OpenTelemetry (quando OTEL_ENABLED=true) ---
OTEL_EXPORTER_OTLP_ENDPOINT=    # ex: http://otel-collector:4318
OTEL_SERVICE_NAME=astrum-api

# --- Cloudflare Workers AI (quando EDGE_INFERENCE_MODE=shadow) ---
CF_ACCOUNT_ID=
CF_AI_API_TOKEN=

# --- Provider failover (quando PROVIDER_FAILOVER_ENABLED=true) ---
PROVIDER_ORDER=openai,anthropic,gemini   # CSV de providers na ordem de preferência

# --- Shadow mirroring do legacy → v2 ---
FASTIFY_INTERNAL_URL=http://localhost:3001  # URL interna do Fastify para shadow mirroring

# --- PLANO I (Uber do Técnico) — IA de campo (I-4) ---
VISION_STRUCTURED_ENABLED=false      # true | false  (IA-04; liga a visão p/ diagnóstico + validação de foto "depois")
FIELD_SUMMARY_LLM_ENABLED=false      # true | false  (I-4; resumo da OS via GPT-4o-mini; off = resumo determinístico)
FIELD_WHATSAPP_NOTIFY_ENABLED=false  # true | false  (I-4; envia WhatsApp "técnico a caminho" ao cliente no evento a_caminho)
