{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx vite build",
  "outputDirectory": "dist",
  "installCommand": "npm install --workspaces=false --include=dev --no-audit --no-fund",
  "framework": null,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://api.astrumlabs.online/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
